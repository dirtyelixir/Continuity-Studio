{
  "canon": [
    {
      "description": "二十出頭香港青年，身形偏瘦、肩略內收；長橢圓臉、平直濃眉、左眉尾小缺口、黑色短髮貼額。",
      "facts": [
        "灰色圓領棉T恤、深藍長褲、灰白跑鞋，全章不換裝。",
        "右褲袋放摺刀，左褲袋放黑色手機；不戴首飾。",
        "遇險先停手、咬緊下顎；決定以踏實雙腳呈現。",
        "與母親住二十八樓；父親六年前因癌症去世。"
      ],
      "id": "c_leyan",
      "kind": "character",
      "name": "陳樂言",
      "scope": "public"
    },
    {
      "description": "約六十歲，矮壯、方臉、寬鼻、右面頰凹痕；灰黑短髮、稀疏鬍根。",
      "facts": [
        "褪色橄欖綠短袖恤衫、炭灰工裝褲、黑膠底鞋、左腕舊鋼錶。",
        "住二十七樓，妻子仍在；曾分退燒藥給樂言母親。",
        "取水時左手提兩桶，右手持長身螺絲批。"
      ],
      "id": "c_chang",
      "kind": "character",
      "name": "昌叔",
      "scope": "auto"
    },
    {
      "description": "四十多歲，窄肩、長臉、黑直髮至背中，赤腳穿及膝白睡裙。",
      "facts": [
        "住十一樓，曾帶女兒上學。",
        "本章感染失控；眼白充血、嘴唇乾裂、下巴深啡污漬、右指甲破損。",
        "遭制服後死亡；不於後續鏡頭復起。"
      ],
      "id": "c_wong",
      "kind": "character",
      "name": "黃太",
      "scope": "auto"
    },
    {
      "description": "灰水泥雙跑樓梯，綠色鋼扶手、每層狹窄氣窗及綠色防煙門。",
      "facts": [
        "主動作區為十三樓轉角至十二樓平台。",
        "機位保持中井同側，下行往畫右上行往畫左。",
        "十二樓門框左側有深色刮痕；轉角有一粒碎石。"
      ],
      "id": "l_stairs",
      "kind": "location",
      "name": "住宅消防樓梯",
      "scope": "auto"
    },
    {
      "description": "半透明長方膠樽，藍色旋蓋及一體提手。",
      "facts": [
        "開章由樂言左手提空樽；取水後盛五公升。",
        "逃跑仍留在樂言左手，不憑空消失。"
      ],
      "id": "p_jug",
      "kind": "prop",
      "name": "五公升膠水樽",
      "scope": "auto"
    },
    {
      "description": "兩個乳白膠桶，黑色提把，其中一桶外壁有藍膠帶。",
      "facts": [
        "遇襲掉在十二樓平台，事後由昌叔拾回。",
        "返家後部分取水分給樂言，家中總存水約八公升。"
      ],
      "id": "p_buckets",
